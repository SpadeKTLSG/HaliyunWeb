# 如需添加更多环境变量，请以 VITE_APP_ 开头声明
# 在代码中使用 import.meta.env.VITE_APP_XXX 获取指定变量

# 环境配置标识
VITE_APP_ENV = 'development'

# api接口请求地址 (后端 Gateway)
VITE_APP_BASE_API = 'http://localhost:10000'

# 静态资源文件url
VITE_APP_RESOURCES_URL = 'https://myOSS.com/'

# 路由类型 : dynamic(动态路由) | static(伪静态路由)
# VITE_APP_ROUTER_TYPE = 'dynamic'
VITE_APP_ROUTER_TYPE = 'static'
